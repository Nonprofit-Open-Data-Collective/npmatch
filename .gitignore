# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site is served from main branch /docs, so it IS tracked

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Large local data (BMF/SAM reference + dev datasets & caches) — kept locally,
# not committed.
/data-raw/

# data-dev holds the run pipeline. The SCRIPTS and hand-written methodology docs
# ARE tracked — they are the only record of how a run was produced. The data
# they operate on is not: reference extracts and caches run to gigabytes, and
# the agent packets and per-chunk outputs number in the thousands and are
# rebuildable.
/data-dev/**
!/data-dev/**/
!/data-dev/**/*.R
!/data-dev/**/*.sh
!/data-dev/**/*.qmd

# methodology, operator and provenance docs
!/data-dev/**/*BRIEF*.md
!/data-dev/**/*PLAN*.md
!/data-dev/**/README.md
!/data-dev/**/*-GUIDE.md
!/data-dev/**/DATA-DICTIONARY-*.md
!/data-dev/**/*REPORT*.md

# ...but not the generated per-chunk reports, the agent packet batches, or
# project run directories — rebuildable, and thousands of files.
/data-dev/**/report-[0-9]*.md
/data-dev/**/*-batches/
/data-dev/runs/
/vignettes/*_files/
/vignettes/*.err
